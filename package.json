{
  "name": "iobroker.nut2",
  "version": "0.15.0",
  "description": "ioBroker adapter for Network UPS Tools (NUT) monitoring",
  "author": {
    "name": "krobi",
    "email": "krobi@power-dreams.com"
  },
  "contributors": [
    {
      "name": "Claude (Anthropic)",
      "role": "Coding assistance"
    }
  ],
  "homepage": "https://github.com/krobipd/ioBroker.nut2",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "nut",
    "ups",
    "network ups tools",
    "uninterruptible power supply",
    "power",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krobipd/ioBroker.nut2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "admin",
    "build",
    "docs",
    "io-package.json",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.1.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^5.0.0",
    "iobroker-adapter-checks": "^0.4.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "main": "build/main.js",
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "check": "tsc --noEmit",
    "test:ts": "vitest run",
    "test:unit": "vitest run",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:inventory": "mocha test/inventory.js --exit",
    "test": "npm run test:ts && npm run test:package",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . \"!build/**\" \"!io-package.json\" \"!.github/dependabot.yml\"",
    "format:check": "prettier --check . \"!build/**\" \"!io-package.json\" \"!.github/dependabot.yml\"",
    "release": "release-script",
    "release-patch": "release-script patch --yes --all",
    "release-minor": "release-script minor --yes --all",
    "release-major": "release-script major --yes --all",
    "translate": "translate-adapter",
    "fix:changelog": "node -e \"const fs=require('fs');for(const[f,r]of[['README.md',/^(-->[ \\t]*)\\r?\\n(#{1,6} )/m],['CHANGELOG_OLD.md',/^(#{1,6} .*)\\r?\\n(#{1,6} )/]])if(fs.existsSync(f)){const t=fs.readFileSync(f,'utf8'),n=t.replace(r,(m,a,b)=>a+'\\n\\n'+b);if(n!==t)fs.writeFileSync(f,n)}\""
  },
  "bugs": {
    "url": "https://github.com/krobipd/ioBroker.nut2/issues"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    },
    "esbuild": ">=0.25.0"
  }
}
